# Pre-auth branding for the login / loading screens.
# Everything after login comes from the `shop_config` row in Supabase, so these only
# need setting once per client deployment. Copy to `.env.local` and fill in.
#
# Leaving these unset is safe: the UI falls back to a generic "Barbershop" rather than
# to another business's name (see BARBER_V2_PLAN.md defect D4).

VITE_SHOP_NAME="Your Barbershop"
VITE_SHOP_SUBTITLE="Admin Dashboard"
VITE_SHOP_LOGO=""
